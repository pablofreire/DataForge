{
  "Database": {
    "ConnectionString": ""
  },
  "FileStorage": {
    "RootPath": "../../../data/files"
  },
  "Onboarding": {
    "MaxUploadBytes": 2147483648
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 10
