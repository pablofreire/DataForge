@implements IAsyncDisposable
@using System.Text.Json
@inject IJSRuntime JS
@inject AntiforgeryStateProvider AntiforgeryState

<section class="panel" aria-labelledby="upload-title">
    <h2 id="upload-title" class="panel__title">Upload a file</h2>
    <p class="panel__hint">CSV, TSV or TXT with a header row. Comma, semicolon, tab and pipe separators are detected automatically.</p>

    <div class="upload">
        <label class="upload__picker">
            <input type="file" accept=".csv,.tsv,.txt,text/csv" @ref="_fileInput" @onchange="OnFileChangedAsync" disabled="@_uploading" data-testid="upload-input" />
            <span class="upload__button">Choose file</span>
            <span class="upload__name" data-testid="upload-file-name">@(_fileName ?? "No file selected")</span>
        </label>
        <button type="button" class="button button--primary" disabled="@(_fileName is null || _uploading)" @onclick="UploadAsync" data-testid="upload-submit">
            @(_uploading ? "Uploading…" : "Upload")
        </button>
    </div>

    @if (_uploading)
    {
        <ProgressBar Percent="_progress" Label="Upload progress" TestId="upload-progress" />
    }

    <AlertMessage Message="@_error" Tone="danger" TestId="upload-error" />
    <AlertMessage Message="@_notice" Tone="info" TestId="upload-notice" />
</section>

@code {
    private const string ModulePath = "./_content/DataForge.Modules.Onboarding.Presentation/js/datasetUpload.js";

    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter]
    public EventCallback<Guid> OnUploaded { get; set; }

    private ElementReference _fileInput;
    private IJSObjectReference? _module;
    private DotNetObjectReference<UploadPanel>? _selfReference;
    private string? _fileName;
    private bool _uploading;
    private double _progress;
    private string? _error;
    private string? _notice;

    [JSInvokable]
    public Task ReportProgress(int percent)
    {
        _progress = percent;
        return InvokeAsync(StateHasChanged);
    }

    private async Task<IJSObjectReference> ModuleAsync() =>
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);

    private async Task OnFileChangedAsync(ChangeEventArgs _)
    {
        _error = null;
        _notice = null;
        _fileName = await (await ModuleAsync()).InvokeAsync<string?>("selectedFileName", _fileInput);
    }

    private async Task UploadAsync()
    {
        _uploading = true;
        _progress = 0;
        _error = null;
        _notice = null;
        _selfReference ??= DotNetObjectReference.Create(this);

        var token = AntiforgeryState.GetAntiforgeryToken();
        var antiforgery = new { headerName = AntiforgeryDefaults.HeaderName, token = token?.Value };
        var result = await (await ModuleAsync()).InvokeAsync<UploadResult>("uploadDataset", _fileInput, $"/api/projects/{ProjectId}/datasets", antiforgery, _selfReference);

        _uploading = false;
        if (!result.Ok || result.Body is null)
        {
            _error = ReadError(result) ?? "The upload failed. Check your connection and try again.";
            return;
        }

        using var document = JsonDocument.Parse(result.Body);
        var data = document.RootElement.GetProperty("data");
        var datasetId = data.GetProperty("dataset").GetProperty("datasetId").GetGuid();
        if (data.GetProperty("isDuplicate").GetBoolean())
        {
            _notice = "This file was already uploaded to the project. Opening the existing dataset.";
        }

        await OnUploaded.InvokeAsync(datasetId);
    }

    private static string? ReadError(UploadResult result)
    {
        if (string.IsNullOrWhiteSpace(result.Body))
        {
            return null;
        }

        try
        {
            using var document = JsonDocument.Parse(result.Body);
            return document.RootElement.TryGetProperty("error", out var error) && error.ValueKind == JsonValueKind.Object
                ? error.GetProperty("message").GetString()
                : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
