root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.{js,css,razor,cshtml,html}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error

# Language preferences
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Interfaces start with I
dotnet_naming_rule.interfaces_prefix.severity = warning
dotnet_naming_rule.interfaces_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_prefix.style = prefix_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# Analyzer tuning (documented in docs/engineering/coding-standards.md)
dotnet_diagnostic.CA1515.severity = none   # public types are required across module projects
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage source generators used on hot paths only
dotnet_diagnostic.CA1062.severity = none   # nullable reference types already enforce this
dotnet_diagnostic.CA1711.severity = none   # "...EventHandler" suffix is part of our naming convention
dotnet_diagnostic.CA2007.severity = none   # no SynchronizationContext in ASP.NET Core
dotnet_diagnostic.CA1716.severity = none   # module names may collide with VB keywords
dotnet_diagnostic.IDE0005.severity = warning

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none   # Method_Scenario_ExpectedResult test naming
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.xUnit1051.severity = suggestion   # false positives on NSubstitute Received()/Arg setups
